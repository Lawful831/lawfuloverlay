# LawfulOverlay Server — environment configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Required ────────────────────────────────────────────────────────────────

# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your-bot-token-here

# Comma-separated Discord user IDs whose messages will be relayed
TARGET_USER_IDS=123456789,987654321

# The numeric Guild (server) ID to monitor
TARGET_SERVER_ID=111222333444555666

# ── Optional ─────────────────────────────────────────────────────────────────

# Host/port for the WebSocket server (defaults below)
WS_HOST=0.0.0.0
WS_PORT=8765

# ── Socket access (required in practice) ────────────────────────────────────
# Shared token every client must send as ?token=... on the WebSocket URL.
# The server refuses to start when this is empty.
WS_TOKEN=change-me-to-a-long-random-string

# Comma-separated browser origins allowed to connect. Native clients send no
# Origin header and are unaffected. A browser page from any other origin is
# closed with 1008, which is what stops cross-site WebSocket hijacking.
WS_ORIGINS=

# ── Limits ──────────────────────────────────────────────────────────────────
WS_MAX_CLIENTS=25
WS_MAX_PER_IP=3
WS_MAX_FRAME_BYTES=65536
WS_MAX_FRAMES_PER_S=20

# ── TLS (optional; terminate in the app instead of a proxy) ─────────────────
# WS_TLS_CERT=/certs/fullchain.pem
# WS_TLS_KEY=/certs/privkey.pem
